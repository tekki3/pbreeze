# PBreeze environment configuration
# System environment variables override this file.
# Use NAME=value and true/false for booleans. Quotes around values are optional.
# Comments must be on their own lines; no interpolation or multiline values.
# Keep .env private and out of version control. Never put real secrets in .env.example.
# A commented setting is not set here: the framework default applies if available.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Display name used by application pages and API metadata.
APP_NAME=PBreeze

# Trusted base URL used in verification and password-reset emails.
# Set the actual public HTTPS URL before sending production emails.
APP_URL=http://127.0.0.1:8000

# Allowed environments: local, testing, production.
# Production enables additional safeguards; do not use local in production.
APP_ENV=local

# Detailed web errors are shown only when APP_ENV=local and this is true.
# Keep false in production. Unexpected API errors always remain generic.
APP_DEBUG=false

# Secret encryption key: base64: followed by a base64-encoded random 32-byte key.
# Run php breeze key:generate and copy its output here securely.
# Empty leaves encryption unavailable. Back up the key: replacing it does not
# re-encrypt old data and prevents that data from being decrypted with the new key.
APP_KEY=

# -----------------------------------------------------------------------------
# Display formatting
# -----------------------------------------------------------------------------

# Default Intl locale for dates, money, decimals, and percentages.
# Does not translate framework UI. Individual formatting calls can override it.
APP_LOCALE=en-US

# Default IANA time zone for displayed dates/times, for example UTC or Europe/Paris.
# Does not change the process-wide PHP time zone.
APP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Sessions and API documentation
# -----------------------------------------------------------------------------

# Send session cookies only over HTTPS when true.
# Set true behind an HTTPS reverse proxy; also enforce HTTPS at the proxy.
# Forwarded headers are not automatically trusted.
SESSION_SECURE_COOKIE=false

# Optional override for HTTP Swagger UI and OpenAPI endpoints.
# When omitted: enabled in local/testing, disabled in production.
# The CLI OpenAPI export remains available regardless of this setting.
# API_DOCS_ENABLED=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Supported native PDO drivers: sqlite, mysql, sqlsrv.
# SQL Server requires pdo_sqlsrv and Microsoft's ODBC Driver on Windows/Linux.
DB_CONNECTION=sqlite

# SQLite: local file path relative to the project root, or an absolute path.
# MySQL/SQL Server: name of an existing database. Keep SQLite files outside public/.
DB_DATABASE=database/app.sqlite

# Server connection settings below are ignored when using SQLite.
# Hostname/address; the default uses a local TCP connection.
DB_HOST=127.0.0.1

# TCP port, from 1 through 65535. MySQL: 3306; SQL Server: set 1433.
DB_PORT=3306

# Database login. Use a dedicated least-privilege account in production.
# For SQL Server, set a SQL authentication login, not the MySQL root default.
DB_USERNAME=root

# Secret database password. An empty example is not a production recommendation.
DB_PASSWORD=

# SQL Server only: encrypt the connection (true/false). Keep true in production.
DB_ENCRYPT=true

# SQL Server only: bypass certificate verification (true/false).
# Keep false in production; install a trusted server certificate instead.
DB_TRUST_SERVER_CERTIFICATE=false

# -----------------------------------------------------------------------------
# Application logging
# -----------------------------------------------------------------------------

# Keep today and the preceding four UTC dates by default (5 calendar days total).
# Allowed range: 1..3650. Old daily files are pruned on writes, not by a timer.
LOG_RETENTION_DAYS=5

# Minimum severity: debug, info, notice, warning, error, critical, alert, emergency.
# Levels above error also filter automatic error entries. Logs are private JSONL.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------

# Default per-file limit in bytes: 2097152 = 2 MiB. Must be a positive integer.
# Upload handlers can override it. Allowed file types must be set in each handler.
# PHP upload_max_filesize/post_max_size and web-server limits are configured
# separately; this setting cannot raise them. Allow for multipart overhead.
UPLOAD_MAX_BYTES=2097152

# -----------------------------------------------------------------------------
# Email storage and sender
# -----------------------------------------------------------------------------

# Store immediate SMTP sends and imported IMAP messages in the emails table.
# Explicitly queued mail (including authentication mail) is stored even if false.
# Run migrations before using database-backed mail.
MAIL_LOG=true

# Default sender: a plain ASCII email address, without a display name.
# Replace example.test with a sender authorized by your SMTP provider.
MAIL_FROM=noreply@example.test

# -----------------------------------------------------------------------------
# Outgoing email (SMTP)
# -----------------------------------------------------------------------------

# SMTP hostname/address. Configure before sending mail or running mail:work.
SMTP_HOST=

# SMTP TCP port, usually 587 for STARTTLS or 465 for immediate TLS.
SMTP_PORT=587

# starttls upgrades the connection; tls encrypts from the start.
# none is allowed only on unauthenticated localhost. Peer verification stays on.
SMTP_ENCRYPTION=starttls

# SMTP authentication username; leave empty only if your server permits it.
SMTP_USERNAME=

# Secret SMTP password or provider app password.
SMTP_PASSWORD=

# Socket timeout in seconds, from 1 through 300.
# A timeout after message submission can mean uncertain delivery; do not blindly retry.
SMTP_TIMEOUT=15

# Optional readable local CA bundle path. Empty uses PHP/system trust.
# Use forward slashes in Windows paths, for example C:/certificates/ca.pem.
SMTP_CA_FILE=

# -----------------------------------------------------------------------------
# Incoming email (IMAP)
# -----------------------------------------------------------------------------

# IMAP hostname/address. The native client is read-only and does not mark mail Seen.
IMAP_HOST=

# IMAP TCP port, usually 993 for immediate TLS or 143 for STARTTLS.
IMAP_PORT=993

# tls, starttls, or none. none is restricted to unauthenticated localhost.
IMAP_ENCRYPTION=tls

# IMAP account username.
IMAP_USERNAME=

# Secret IMAP password or provider app password.
IMAP_PASSWORD=

# Socket timeout in seconds, from 1 through 300.
IMAP_TIMEOUT=15

# Optional readable local CA bundle; empty uses PHP/system trust.
IMAP_CA_FILE=

# Mailbox to examine. Use ASCII or an IMAP modified UTF-7 mailbox name.
IMAP_MAILBOX=INBOX

# Maximum bytes per retrieved message: 10485760 = 10 MiB.
# Allowed range: 1..52428800 (50 MiB). A retrieval batch is also capped at 50 MiB.
IMAP_MAX_BYTES=10485760
