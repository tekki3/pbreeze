<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS 10+, CGI/FastCGI feature, PHP 8.3+ NTS, and URL Rewrite 2.x.
     Set the site physical path to public and install the PHP FastCGI handler
     at server/site level. HTTPS bindings and NTFS ACLs are administrator tasks. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <!-- Preserve the framework's JSON bodies and Allow headers for 4xx/5xx. -->
    <httpErrors existingResponse="PassThrough" errorMode="Custom" />
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <requestLimits maxAllowedContentLength="8388608" />
        <hiddenSegments>
          <remove segment=".env" />
          <remove segment=".git" />
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="PBreeze private paths" stopProcessing="true">
          <match url="(^|/)\.|\.(env|sqlite[0-9]?|log|ini|config|sql|bak)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="PBreeze front controller" stopProcessing="true">
          <match url="^index\.php$" ignoreCase="false" />
          <action type="None" />
        </rule>
        <rule name="PBreeze block other PHP scripts" stopProcessing="true">
          <match url="\.(php[0-9]?|phtml|phar)(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="PBreeze static assets" stopProcessing="true">
          <match url="\.(css|js|png|jpg|jpeg|gif|webp|ico|svg|woff2?)$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="PBreeze routes" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
